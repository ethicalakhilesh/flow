# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored - never commit real keys.

# Airtable base ID (found in the API docs for your base, or the base's URL:
# airtable.com/appXXXXXXXXXXXXXX/...)
AIRTABLE_BASE_ID=

# Airtable Personal Access Token (Account settings -> Developer hub ->
# Personal access tokens). Needs data.records:read scope on this base at minimum.
AIRTABLE_API_KEY=

# sso-auth (OIDC) - Phase 4: Flow as an sso-auth client.
# No shared secret here on purpose - PKCE + sso-auth's public JWKS replace
# that entirely, so there's nothing secret to leak from this file besides
# the Airtable key above.

# sso-auth's deployed URL, no trailing slash (its
# /.well-known/openid-configuration must be reachable at this exact origin).
SSO_ISSUER=

# This must match the clientId of the row registered for Flow in sso-auth's
# own Clients table - not something you invent independently here.
SSO_CLIENT_ID=flow

# Flow's own callback route. Must match, character-for-character, one of
# the redirectUris registered for this clientId in sso-auth's Clients
# table, including scheme and any trailing slash - OIDC redirect_uri
# matching is exact-string, not prefix/wildcard.
SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Flow's own session signing secret (HS256) - not related to sso-auth at
# all, this signs Flow's own session cookie set after a successful login.
# Generate one with: openssl rand -base64 32
FLOW_SESSION_SECRET=
